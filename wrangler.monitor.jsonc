{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hacker-times-monitor",
  "account_id": "dc81a3cb74492ea63c9f3e14f13711a2",
  "main": "worker/monitor.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "durable_objects": {"bindings": [{"name": "MONITOR", "class_name": "SiteMonitor"}]},
  "services": [{"binding":"PUBLISHER_RECOVERY","service":"hacker-times-production","entrypoint":"PublisherRecoveryObserver"}],
  "migrations": [{"tag": "monitor-v1", "new_sqlite_classes": ["SiteMonitor"]}],
  "send_email": [{"name": "EMAIL"}],
  "vars": {"ALERT_FROM": "alerts@hackertimes.ca"},
  "triggers": {"crons": ["2-57/5 * * * *"]}
}
